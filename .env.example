# ==========================================================================
# Ripzilla Portal — environment variables
#
# Copy this file to `.env.local` and fill in the real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored — never commit real keys.
# Every variable must be prefixed with VITE_ or Vite will not expose it to
# the client. All three are required; the app fails to start without them.
# ==========================================================================

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL and client key from the Supabase dashboard:
#   Project Settings → API Keys
#
# Supabase has two key formats. Either works here — createClient() accepts
# both, and row-level security gates queries identically:
#
#   New (preferred)  sb_publishable_...   an opaque, non-JWT string
#   Legacy           eyJ...               a JWT with "role": "anon"
#
# Legacy anon keys still work but Supabase is deprecating them by the end of
# 2026, so prefer the publishable key on new setups.
#
# This key is public and browser-safe by design — it is protected by row-level
# security, not by secrecy. Never put a SECRET key here (sb_secret_... or the
# legacy service_role JWT): everything in a VITE_ variable is bundled into the
# client, so anyone can read it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# ── Ripzilla API ──────────────────────────────────────────────────────────
# Base URL of the FastAPI service in src/components/ripzilla-api.
# Serves /sets, /sets/parse, /sets/upload, /generate-report and /streams.
# No trailing slash — the app appends paths directly.
#
# Local development (uvicorn main:app --reload defaults to port 8000):
VITE_API_URL=http://localhost:8000
#
# Production — set this in your hosting provider's env settings, not here:
# VITE_API_URL=https://api.ripzillatcg.com

# ── Risk-Analysis-Service ─────────────────────────────────────────────────
# Base URL of the Node service in ../Risk-Analysis-Service, deployed on
# Railway. Serves POST /api/roi (Break ROI tool) and POST /api/price-break.
# No trailing slash — the app appends paths directly.
#
# Local development (npm start defaults to port 3000):
VITE_RISK_API_URL=http://localhost:3000
#
# Production — set this in your hosting provider's env settings, not here:
# VITE_RISK_API_URL=https://risk.ripzillatcg.com
